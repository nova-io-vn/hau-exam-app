# Public API Gateway URL only. Never put internal service ports or secrets here.
EXPO_PUBLIC_API_BASE_URL=https://api.nova.io.vn
# Optional: defaults to the API base URL with http -> ws.
EXPO_PUBLIC_WS_BASE_URL=wss://api.nova.io.vn
# EAS/Expo project id required for native Expo Push Token registration.
EXPO_PUBLIC_EXPO_PROJECT_ID=
